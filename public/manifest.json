{
  "id": "/",
  "name": "Sonora Music",
  "short_name": "Sonora",
  "description": "Windows-native Apple Music experience for local music collections with high-resolution audio, real-time offline lyrics, smart playlists, and local folder synchronization.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d0d12",
  "theme_color": "#121217",
  "orientation": "any",
  "categories": ["music", "entertainment", "audio"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Listen Now",
      "url": "/?view=listen-now",
      "description": "Open Sonora Home"
    },
    {
      "name": "Smart Playlists",
      "url": "/?view=smart",
      "description": "View Hi-Res Smart Playlists"
    },
    {
      "name": "Local Storage Folders",
      "url": "/?view=folders",
      "description": "Manage Local Folders"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Audio Files",
      "accept": {
        "audio/flac": [".flac"],
        "audio/x-flac": [".flac"],
        "audio/wav": [".wav"],
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/ogg": [".ogg"]
      }
    }
  ]
}
