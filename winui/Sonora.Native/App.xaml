<Application
    x:Class="Sonora.Native.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple Music Brand Colors -->
            <SolidColorBrush x:Key="AppleMusicAccentBrush" Color="#FA2D48" />
            <SolidColorBrush x:Key="AppleMusicCyanBrush" Color="#00D4FF" />
            <SolidColorBrush x:Key="DarkSurfaceBrush" Color="#121217" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
